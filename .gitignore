# System and Editor files
.DS_Store
.vscode/

# Python cache and bytecode files
__pycache__/
*.py[cod]

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data files
data/ml-100k/*
data/ml-1m/*
data/lastfm-1k/*
data/foursquare/*
data/harvardx/*

!data/ml-100k/README.txt
!data/ml-1m/README.txt
!data/lastfm-1k/README.txt
!data/foursquare/dataset_TIST2015_readme.txt
!data/foursquare/dataset_UbiComp2016_readme.txt

# Ignore run metrics from all datasets except ml-100k
results/runs/*/*/metrics_top*.csv
!results/runs/ml-100k/*/metrics_top*.csv

# Ignore the per-user NDCG arrays everywhere: large, and regenerated by training.
results/runs/*/*/ndcg.npz

# The index beside them says which rows of an append-only metrics CSV are current
results/runs/*/*/ndcg_index.csv
!results/runs/ml-100k/*/ndcg_index.csv
results/runs/*/user_labels.npz

# Standalone experiment outputs: same policy as the per-dataset runs -- the data
# stays local and is regenerated by its own script; only the READMEs are tracked.
results/other_experiments/*/*.csv
results/other_experiments/*/*.npz
results/other_experiments/*/clean/
results/other_experiments/*/attacked/

# Superseded copies rescued from the old temp/ folders. Local only -- the whole
# folder, README included: it documents files that are not in the repository, so
# on its own it would only puzzle a reader.
results/runs/*/*/_superseded/
results/other_experiments/*/_superseded/

# Progress logs
results/logs/

# Ignore all archives
archive/*

# Local paper drafts and unused Boratto experiment files
paper2.pdf
paper3.pdf
*boratto*

# Ignore Poetry configuration file
poetry.toml

# Local verification runs
_verification/

# Local-only table script
experiments/tables/accuracy_cost.py
results/derived/tables/accuracy_cost/

# Local-only experiment
experiments/robustness_in_fairness_attacks.py

# RecBole working files: atomic files, checkpoints, logs
results/recbole/
